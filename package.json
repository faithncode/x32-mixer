{
  "name": "x32-mixer",
  "version": "0.2.0",
  "description": "Desktop remote control for Behringer X32 / Midas M32 consoles over OSC",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "emulator": "node tools/x32-emulator.js",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "faithncode",
  "build": {
    "appId": "com.faithncode.x32mixer",
    "productName": "X32 Mixer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "X32-Mixer-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null
    },
    "dmg": {
      "title": "X32 Mixer ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "X32 Mixer"
    }
  }
}
